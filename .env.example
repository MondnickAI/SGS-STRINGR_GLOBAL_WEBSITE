# Copy to .env.local for development. Never commit real values.

# Public site URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.stringr-ai.com

# Inquiry form delivery (SMTP). If SMTP_HOST is empty, inquiries are only logged
# to the server console in development and the form reports an error in production.
SMTP_HOST=
SMTP_PORT=587
# "true" for port 465 (implicit TLS); "false" for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Address shown as the sender. Must be a mailbox the SMTP account may send as.
CONTACT_FROM=
# Where inquiries are delivered. Defaults to the email in content/site.json.
CONTACT_TO=
